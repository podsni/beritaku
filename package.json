{
  "name": "beritaku",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "//": "=== Quality Gates ===",
    "typecheck": "tsgo -p tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "//2": "=== Bundled Checks ===",
    "check:fast": "bun run lint && bun run fmt:check",
    "check": "bun run typecheck && bun run lint && bun run fmt:check",
    "//3": "=== Convenience ===",
    "start": "bun src/index.ts",
    "dev": "bun --hot src/index.ts",
    "test": "bun test",
    "fix": "bun run lint:fix && bun run fmt",
    "refresh:news": "bun src/scripts/refreshNewsCsv.ts",
    "bench": "bash scripts/bench.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cloakbrowser": "^0.3.31",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "fast-xml-parser": "^5.8.0",
    "google-news-url-decoder": "^1.2.1",
    "hono": "^4.12.23",
    "playwright-core": "^1.60.0"
  },
  "devDependencies": {
    "@nkzw/oxlint-config": "^1.0.1",
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260218.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.48.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
